{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "~8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "4.3.*",
        "doctrine/doctrine-bundle": "3.2.*",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.7.6",
        "league/commonmark": ">=2.10.7",
        "league/html-to-markdown": ">=5.2.3",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.4.1",
        "stof/doctrine-extensions-bundle": ">=1.15.3",
        "symfony/asset": "~8",
        "symfony/asset-mapper": "^8.1.10",
        "symfony/console": "^8.1.10",
        "symfony/doctrine-messenger": "^8.1.10",
        "symfony/dotenv": "~8",
        "symfony/expression-language": "~8",
        "symfony/flex": "^2.12",
        "symfony/form": "^8.1.10",
        "symfony/framework-bundle": "^8.1.10",
        "symfony/http-client": "^8.1.10",
        "symfony/intl": "^8.1.10",
        "symfony/mailer": "^8.1.10",
        "symfony/mime": "~8",
        "symfony/monolog-bundle": ">=4.1.0",
        "symfony/notifier": "~8",
        "symfony/process": "^8.1.10",
        "symfony/property-access": "^8.1.10",
        "symfony/property-info": "^8.1.10",
        "symfony/runtime": "^8.1.10",
        "symfony/security-bundle": "~8",
        "symfony/security-csrf": "~8.1",
        "symfony/serializer": "^8.1.10",
        "symfony/stimulus-bundle": "^2.36",
        "symfony/string": "^8.1.10",
        "symfony/translation": "^8.1.10",
        "symfony/twig-bundle": "^8.1.9",
        "symfony/ux-cropperjs": "^2.36",
        "symfony/ux-dropzone": ">=3.7",
        "symfony/validator": "^8.1.10",
        "symfony/web-link": "~8",
        "symfony/yaml": "^8.1.10",
        "symfonycasts/reset-password-bundle": "^1.26.1",
        "symfonycasts/verify-email-bundle": ">=1.18",
        "twig/extra-bundle": "^2.12|^3.29.0",
        "twig/intl-extra": ">=3.30.0",
        "twig/markdown-extra": ">=3.29",
        "twig/twig": "^2.12|^3.30.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": ">=8.7.0",
        "doctrine/doctrine-fixtures-bundle": ">=4.3.1",
        "phpunit/phpunit": "^11.5.57",
        "symfony/browser-kit": "8.0.*",
        "symfony/css-selector": "8.0.*",
        "symfony/debug-bundle": "8.0.*",
        "symfony/maker-bundle": "^1.68.0",
        "symfony/stopwatch": "8.0.*",
        "symfony/web-profiler-bundle": "8.1.*"
    }
}
